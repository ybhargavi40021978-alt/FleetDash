PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/fleetdash
JWT_SECRET=replace-with-a-long-random-secret
# Enable Redis fan-out only after Redis is running locally or set REDIS_URL.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional JSON array of geofences, each with id and polygon geometry.
# GEOFENCES_JSON=[]
TELEMETRY_TTL_SECONDS=2592000
